<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo UI Regression Suite" verbose="1" parallel="false">
    <listeners>
        <listener class-name="com.qa.ecommerce.tests.ExtentTestListener"/>
    </listeners>
    <test name="E-Commerce UI Tests">
        <classes>
            <class name="com.qa.ecommerce.tests.LoginTests"/>
            <class name="com.qa.ecommerce.tests.ProductTests"/>
            <class name="com.qa.ecommerce.tests.CartTests"/>
            <class name="com.qa.ecommerce.tests.CheckoutTests"/>
        </classes>
    </test>
</suite>
